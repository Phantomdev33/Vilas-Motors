DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=vilas_motor
POSTGRES_USER=vilas
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Supabase: copia la URI de Connect > Session pooler (puerto 5432).
# DATABASE_URL tiene prioridad sobre POSTGRES_* y DATABASE_ENGINE.
# Reemplaza la contraseña y codifica sus caracteres especiales en la URI.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Alternativa con POSTGRES_*: copia host/usuario/base del panel y activa SSL.
# POSTGRES_SSLMODE=require
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_ENGINE=sqlite is an explicit local demonstration option only.
