DJANGO_DEBUG=false
SMS_BACKEND=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Render añade RENDER_EXTERNAL_HOSTNAME automáticamente.
DJANGO_ALLOWED_HOSTS=
FRONTEND_URL=https://vilas-motors-muhdcegrz-phantomdev33s-projects.vercel.app
# El origen de FRONTEND_URL se añade a CSRF_TRUSTED_ORIGINS automáticamente.
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# MongoDB se usa SOLO para las imagenes adjuntas a lecturas manuales.
# Configura estas variables en el servidor, nunca en el frontend.
MONGODB_URI=
MONGODB_IMAGE_DATABASE=vilas_images
# Umbral de silencio GPS; intervalos mayores quedan sin estimar.
GPS_MAX_EVENT_GAP_SECONDS=86400
