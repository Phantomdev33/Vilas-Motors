{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {"X-Vilas-Routing": "render-proxy-v2"},
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "https://vilas-motors.onrender.com/api/$1",
      "headers": {"Cache-Control": "private, no-store"}
    },
    {"handle": "filesystem"},
    {"src": "/(.*)", "dest": "/index.html"}
  ]
}
